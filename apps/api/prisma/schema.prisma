// Decide Nicaragua — Schema de Prisma
// Fuente de verdad de la base de datos.
// Cambios requieren migración explícita: pnpm db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/**
 * AccountStatus — ciclo de vida de una cuenta de usuario.
 * Flujo:
 * invited → pending_verification → verified_citizen | observer | external_collaborator
 * → rejected
 * (estado activo) → suspended
 * Nota: combina estado del ciclo de vida y nivel de acceso para MVP.
 * Ver docs/DECISIONS.md ADR-009.
 */
enum GroupType {
  territorial_origin // Agrupado por departamento de Nicaragua de nacimiento
  territorial_residence // Agrupado por país de residencia
  custom // Creado manualmente por un administrador
  trabajo // Grupo de trabajo (subgrupo, comisión o bifurcación) que cuelga de una comunidad
}

enum TrabajoTipo {
  subgrupo
  comision
  bifurcacion
}

enum TrabajoEstado {
  convocando
  activo
  pausado
  cerrado
  archivado
  eligiendo
}

enum SortitionStatus {
  pending // Creado, pendiente de ejecución
  completed // Ejecutado — resultado y semilla disponibles
  cancelled // Cancelado por el creador
}

enum ElectionStatus {
  draft // Borrador — no acepta votos
  open // Abierta — acepta votos hasta endsAt
  tallied // Contada — resultado disponible
  cancelled // Cancelada por el creador
}

enum ProposalStatus {
  draft // Borrador visible solo para el autor
  open // Abierta a comentarios y señales
  closed // Cerrada por el autor; no acepta nuevas señales ni comentarios
  archived // Archivada; solo lectura
}

enum SignalType {
  support // Apoya la propuesta
  neutral // Neutral / necesita más información
  object // Objeta la propuesta
}

enum ProposalKind {
  tema // debate abierto
  propuesta // propuesta formal: plazo de deliberación y luego votación
}

enum ModerationTarget {
  tema
  respuesta
  inquietud
  frase
  solucion
  informe
}

enum Origen {
  persona
  asistente
}

enum DecisionFase {
  modo
  objecion
  votacion
  contada
  cancelada
}

enum DecisionModo {
  excluyentes
  compatibles
}

enum DecisionResultado {
  aprobada
  ninguna
  empate
  sin_quorum
  sin_soluciones
}

enum FraseVotoValor {
  de_acuerdo
  en_desacuerdo
  paso
}

enum InquietudStatus {
  abierta
  en_plazo
  en_debate
  respondida
  abierta_por_la_comunidad
}

enum ModerationStatus {
  oculto // ocultado por la moderación
  apelado // el autor apeló
  restaurado // la mesa lo devolvió a la vista
  confirmado // la mesa mantuvo la moderación tras la apelación
  pendiente // solicitud que espera la segunda firma; el contenido sigue visible
  provisional // causa urgente: oculto ya, a la espera de la segunda firma
  rechazado // la mesa no dio la segunda firma o venció el plazo
}

enum ModeracionCausa {
  datos_personales
  insultos_amenazas
  spam
  ilegal_violencia
  suplantacion
  odio
}

enum AccountStatus {
  invited
  pending_verification
  verified_citizen
  observer
  external_collaborator
  rejected
  suspended
}

enum BoardRole {
  administrador
  coordinador_general
  secretario
}

enum SeatSource {
  fundador // asignado durante el arranque, antes de la primera elección
  eleccion // resultado de una elección (plan 3)
}

enum ReferenceKind {
  invitador // quien invitó a la persona
  segunda // administrador u otro miembro del mismo territorio o comunidad de acogida
}

enum BoardActionType {
  suspend_user
  change_origin
  change_rule
}

enum CambioReglaEstado {
  en_votacion
  pendiente_mesa
  aplicado
  rechazado
  rechazado_mesa
  sin_participacion
  anulado
}

enum BoardActionStatus {
  pending
  approved
  rejected
  executed
}

// ─── Tablas principales ───────────────────────────────────────────────────────

/**
 * User — identidad privada del usuario.
 * Esta tabla contiene PII (email, hash de contraseña).
 * Los módulos de negocio deben operar con Profile, no con User directamente.
 * Solo AuthModule y UsersModule acceden a esta tabla.
 */
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String? // Null mientras la invitación no ha sido aceptada

  status AccountStatus @default(invited)

  // Trazabilidad de invitación
  invitedById String? @db.Uuid
  invitedBy   User?   @relation("UserInvitations", fields: [invitedById], references: [id])
  invitations User[]  @relation("UserInvitations")

  // Token de invitación (one-time, expira en 72h)
  inviteToken     String?   @unique
  inviteExpiresAt DateTime? @db.Timestamptz

  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  lastLoginAt DateTime? @db.Timestamptz

  // Relaciones
  profile            Profile?
  auditEvents        AuditEvent[]            @relation("AuditEventActor")
  referencesReceived VerificationReference[] @relation("ReferencesReceived")

  @@index([email])
  @@index([inviteToken])
  @@index([status])
  @@map("users")
}

/**
 * Profile — perfil operativo público/semi-público.
 * Separado de User para permitir anonimización parcial.
 * Los módulos de deliberación, votación y grupos usan profile_id.
 */
model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName     String
  birthDepartment String? // Departamento de Nicaragua de origen
  currentCountry  String? // País de residencia actual (ISO 3166-1 alpha-2)
  currentRegion   String? // En EE. UU.: estado (código de 2 letras). Null fuera de EE. UU.

  // Si el perfil es visible para otros usuarios de la plataforma
  isPublic Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  memberships           GroupMembership[]
  proposals             Proposal[]
  comments              ProposalComment[]
  signals               ConsensusSignal[]
  electionsCreated      Election[]                @relation("ElectionCreator")
  ballots               Ballot[]
  sortitionDrawsCreated SortitionDraw[]           @relation("SortitionCreator")
  sortitionSelections   SortitionMember[]
  boardSeats            BoardSeat[]
  referencesGiven       VerificationReference[]   @relation("ReferencesGiven")
  boardApprovals        BoardApproval[]
  boardActionsProposed  BoardAction[]             @relation("BoardActionProposer")
  forumsCreated         Forum[]                   @relation("ForumCreator")
  moderationsDone       ModerationAction[]        @relation("Moderator")
  textosEnRevision      TextoEnRevision[]
  inquietudes           Inquietud[]
  inquietudApoyos       InquietudApoyo[]
  comisionVoluntarios   ComisionVoluntario[]
  comisionRenovaciones  ComisionRenovacionApoyo[]
  comisionPapeletas     ComisionPapeleta[]
  frases                Frase[]
  frasesVotos           FraseVoto[]
  soluciones            Solucion[]
  papeletas             DecisionPapeleta[]
  objecionesModo        ObjecionModo[]

  @@map("profiles")
}

/**
 * Group — grupo de participación (territorial o personalizado).
 * Los grupos territoriales se crean automáticamente al registrarse.
 */
model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique // ej: "managua", "country-cr"
  type        GroupType
  description String?
  isActive    Boolean   @default(true)

  /// Grupos de trabajo: comunidad (o nivel general) de la que cuelga.
  parentGroupId String? @db.Uuid
  parent        Group?  @relation("GrupoTrabajo", fields: [parentGroupId], references: [id], onDelete: Cascade)
  hijos         Group[] @relation("GrupoTrabajo")

  trabajoTipo        TrabajoTipo?
  trabajoEstado      TrabajoEstado?
  proposito          String?        @db.VarChar(1000)
  convocatoriaEndsAt DateTime?      @db.Timestamptz
  pocosMiembrosDesde DateTime?      @db.Timestamptz
  creadoPorProfileId String?        @db.Uuid

  /// Comisiones y bifurcaciones. NOTA: dos índices únicos parciales hechos a mano en SQL
  /// (Prisma no los conoce; no los borre en migraciones futuras):
  ///  - grupos_comision_viva_por_solucion: UNIQUE ("origenSolucionId") WHERE "trabajoTipo" = 'comision'
  ///    AND "trabajoEstado" NOT IN ('cerrado','archivado')
  ///  - grupos_bifurcacion_por_solucion: UNIQUE ("origenSolucionId") WHERE "trabajoTipo" = 'bifurcacion'
  origenSolucionId   String?          @db.Uuid
  origenGrupoId      String?          @db.Uuid
  tarea              String?          @db.VarChar(2000)
  puestos            Int?
  forma              String?          @db.VarChar(20)
  ampliada           Boolean          @default(false)
  eleccionEndsAt     DateTime?        @db.Timestamptz
  seleccionSemilla   String?
  seleccionPool      Json?
  seleccionAlgoritmo String?
  eleccionResultado  Json?
  activadaAt         DateTime?        @db.Timestamptz
  proximoInformeAt   DateTime?        @db.Timestamptz
  pausaCausa         ModeracionCausa?
  pausaDetalle       String?          @db.VarChar(500)
  pausaApelacion     String?          @db.VarChar(1000)
  pausaApeladaAt     DateTime?        @db.Timestamptz
  /// Inicio de la pausa en curso: al reanudarse, los plazos se corren lo que duró.
  pausadaAt          DateTime?        @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  comisionVoluntarios  ComisionVoluntario[]
  comisionInformes     ComisionInforme[]
  comisionRenovaciones ComisionRenovacionApoyo[]
  comisionPapeletas    ComisionPapeleta[]

  memberships    GroupMembership[]
  proposals      Proposal[]
  elections      Election[]
  sortitionDraws SortitionDraw[]
  forums         Forum[]
  ruleValues     RuleValue[]
  cambiosRegla   CambioRegla[]
  inquietudes    Inquietud[]

  @@index([type])
  @@index([isActive])
  @@index([parentGroupId, trabajoEstado])
  @@map("groups")
}

/**
 * GroupMembership — relación many-to-many entre perfiles y grupos.
 * Única por (groupId, profileId). Creada automáticamente al registrarse.
 */
model GroupMembership {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now()) @db.Timestamptz

  @@unique([groupId, profileId])
  @@index([profileId])
  @@index([groupId])
  @@map("group_memberships")
}

/**
 * Proposal — propuesta de deliberación dentro de un grupo.
 * Solo los miembros del grupo pueden crear propuestas.
 * El autor puede cerrar o archivar su propia propuesta.
 * Los borradores (draft) son visibles para todos los miembros pero
 * no aceptan señales hasta que pasan a estado open.
 */
model Proposal {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  authorProfileId String  @db.Uuid
  author          Profile @relation(fields: [authorProfileId], references: [id])

  title               String         @db.VarChar(200)
  body                String
  status              ProposalStatus @default(open)
  forumId             String?        @db.Uuid
  forum               Forum?         @relation(fields: [forumId], references: [id])
  kind                ProposalKind   @default(tema)
  deliberationEndsAt  DateTime?      @db.Timestamptz
  electionId          String?        @unique @db.Uuid
  conclusion          String?        @db.VarChar(2000)
  objections          String?        @db.VarChar(2000)
  hidden              Boolean        @default(false)
  abiertoPorComunidad Boolean        @default(false)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  closedAt  DateTime? @db.Timestamptz

  comments    ProposalComment[]
  signals     ConsensusSignal[]
  inquietudes Inquietud[]
  frases      Frase[]
  soluciones  Solucion[]
  decision    Decision?
  cambioRegla CambioRegla?

  @@index([forumId])
  @@index([groupId, status])
  @@index([authorProfileId])
  @@map("proposals")
}

/**
 * ProposalComment — comentario sobre una propuesta.
 * Soporta threading de un nivel (parentId apunta a otro comentario raíz).
 * Solo los miembros del grupo pueden comentar.
 * No se permiten nuevos comentarios en propuestas closed/archived.
 */
model ProposalComment {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @db.Uuid
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  authorProfileId String  @db.Uuid
  author          Profile @relation(fields: [authorProfileId], references: [id])

  body     String            @db.VarChar(2000)
  parentId String?           @db.Uuid
  parent   ProposalComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  ProposalComment[] @relation("CommentReplies")
  hidden   Boolean           @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([proposalId])
  @@index([parentId])
  @@map("proposal_comments")
}

/**
 * ConsensusSignal — señal de posición de un miembro sobre una propuesta.
 * Única por (proposalId, profileId) — un miembro, una señal.
 * Se puede actualizar (upsert). Solo en propuestas en estado open.
 */
model ConsensusSignal {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @db.Uuid
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id])

  signal SignalType

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([proposalId, profileId])
  @@index([proposalId])
  @@map("consensus_signals")
}

/**
 * Election — elección con método Condorcet-Schulze.
 * Solo los miembros del grupo pueden crear y votar en elecciones.
 * Las papeletas se cuentan al llamar a POST /tally una vez cerrada.
 * El resultado completo (matrices) se almacena en ElectionResult para
 * verificación independiente.
 */
model Election {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  createdByProfileId String  @db.Uuid
  createdBy          Profile @relation("ElectionCreator", fields: [createdByProfileId], references: [id])

  title       String         @db.VarChar(200)
  description String?
  status      ElectionStatus @default(draft)

  startsAt DateTime @db.Timestamptz
  endsAt   DateTime @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  candidates ElectionCandidate[]
  ballots    Ballot[]
  result     ElectionResult?

  @@index([groupId, status])
  @@index([createdByProfileId])
  @@map("elections")
}

/**
 * ElectionCandidate — opción votable dentro de una elección.
 * `position` determina el orden de visualización y el orden de las matrices.
 */
model ElectionCandidate {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(200)
  description String?
  position    Int // Orden de presentación (1-based, ascendente)

  rankings BallotRanking[]

  @@index([electionId])
  @@map("election_candidates")
}

/**
 * Ballot — papeleta de un votante.
 * Un votante puede actualizar su papeleta mientras la elección esté abierta.
 * El voto final es el registrado cuando se ejecuta el conteo.
 */
model Ballot {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @db.Uuid
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id])

  submittedAt DateTime @default(now()) @db.Timestamptz

  rankings BallotRanking[]

  @@unique([electionId, profileId])
  @@index([electionId])
  @@map("ballots")
}

/**
 * BallotRanking — ranking de un candidato en una papeleta.
 * rank=1 significa más preferido. Los candidatos no incluidos en la papeleta
 * se consideran en último lugar (empatados) durante el conteo.
 */
model BallotRanking {
  id       String @id @default(uuid()) @db.Uuid
  ballotId String @db.Uuid
  ballot   Ballot @relation(fields: [ballotId], references: [id], onDelete: Cascade)

  candidateId String            @db.Uuid
  candidate   ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  rank Int // 1 = más preferido

  @@unique([ballotId, candidateId])
  @@index([ballotId])
  @@map("ballot_rankings")
}

/**
 * ElectionResult — resultado computado de una elección.
 * Almacena las matrices completas para verificación independiente.
 * Una vez creado, no debe modificarse (append-only semántico, aunque no
 * hay trigger en esta tabla — el status 'tallied' de Election lo protege).
 */
model ElectionResult {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @unique @db.Uuid
  election   Election @relation(fields: [electionId], references: [id])

  /**
   * IDs de los candidatos ganadores (puede ser más de uno en empate exacto).
   */
  winners        Json
  /**
   * IDs de los candidatos en el orden de las matrices (por position ASC).
   */
  candidateOrder Json
  /**
   * Matriz de preferencias pairwise: d[i][j] = votos que prefieren i sobre j.
   */
  pairwiseMatrix Json
  /**
   * Matriz de rutas más fuertes (Schulze): p[i][j] = fuerza de ruta i→j.
   */
  schulzeMatrix  Json

  totalBallots Int
  computedAt   DateTime @db.Timestamptz

  @@map("election_results")
}

/**
 * SortitionDraw — sorteo de selección aleatoria verificable.
 * Flujo:
 * 1. Crear (pending) — define grupo, título y tamaño de selección.
 * 2. Ejecutar (completed) — captura el snapshot del pool, genera seed,
 * aplica Fisher-Yates con SHA-256 y guarda los seleccionados.
 * 3. Verificar — cualquier miembro puede recomputar con la seed almacenada.
 * Limitación MVP: la seed es generada por el servidor.
 * Para mayor confianza ver docs/DECISIONS.md ADR-011.
 */
model SortitionDraw {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  createdByProfileId String  @db.Uuid
  createdBy          Profile @relation("SortitionCreator", fields: [createdByProfileId], references: [id])

  title         String  @db.VarChar(200)
  description   String?
  selectionSize Int

  status SortitionStatus @default(pending)

  // Establecidos al ejecutar el sorteo
  seed         String? // 32 bytes en hex — pública para verificación independiente
  algorithm    String? // e.g. "fisher-yates-sha256-v1"
  poolSnapshot Json? // String[] — profileIds ordenados lexicográficamente

  executedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  selectedMembers SortitionMember[]

  @@index([groupId, status])
  @@index([createdByProfileId])
  @@map("sortition_draws")
}

/**
 * SortitionMember — miembro seleccionado en un sorteo.
 * selectionOrder indica la posición en la selección (1-based).
 */
model SortitionMember {
  id     String        @id @default(uuid()) @db.Uuid
  drawId String        @db.Uuid
  draw   SortitionDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id])

  selectionOrder Int

  @@unique([drawId, profileId])
  @@index([drawId])
  @@map("sortition_members")
}

/**
 * NewsletterSubscription — suscripción al boletín informativo.
 * Endpoint público: no requiere cuenta. Almacena email y datos opcionales.
 * Rate limiting estricto en el controlador (5 req / hora por IP).
 */
model NewsletterSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String?
  country   String? // ISO 3166-1 alpha-2 (país de residencia)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([email])
  @@map("newsletter_subscriptions")
}

/**
 * BoardSeat — cargo de la mesa directiva. Un cargo, una persona.
 * Una persona no puede ocupar dos cargos (lo valida BoardService).
 */
model BoardSeat {
  id        String     @id @default(uuid()) @db.Uuid
  role      BoardRole  @unique
  profileId String     @db.Uuid
  profile   Profile    @relation(fields: [profileId], references: [id])
  source    SeatSource
  since     DateTime   @default(now()) @db.Timestamptz

  @@index([profileId])
  @@map("board_seats")
}

/**
 * VerificationReference — una de las dos referencias que verifican a una persona.
 * Una referencia por tipo y una por referente.
 */
model VerificationReference {
  id               String        @id @default(uuid()) @db.Uuid
  subjectUserId    String        @db.Uuid
  subject          User          @relation("ReferencesReceived", fields: [subjectUserId], references: [id], onDelete: Cascade)
  refereeProfileId String        @db.Uuid
  referee          Profile       @relation("ReferencesGiven", fields: [refereeProfileId], references: [id])
  kind             ReferenceKind
  createdAt        DateTime      @default(now()) @db.Timestamptz

  @@unique([subjectUserId, kind])
  @@unique([subjectUserId, refereeProfileId])
  @@index([refereeProfileId])
  @@map("verification_references")
}

/**
 * BoardAction — acción delicada propuesta por un cargo de la mesa.
 * Se ejecuta con 2 aprobaciones de personas distintas; se rechaza con 2 rechazos.
 */
model BoardAction {
  id                  String            @id @default(uuid()) @db.Uuid
  type                BoardActionType
  targetUserId        String?           @db.Uuid
  params              Json
  reason              String            @db.VarChar(500)
  status              BoardActionStatus @default(pending)
  proposedByProfileId String?           @db.Uuid
  proposedBy          Profile?          @relation("BoardActionProposer", fields: [proposedByProfileId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now()) @db.Timestamptz
  resolvedAt          DateTime?         @db.Timestamptz

  approvals BoardApproval[]

  @@index([status])
  @@map("board_actions")
}

model BoardApproval {
  id        String      @id @default(uuid()) @db.Uuid
  actionId  String      @db.Uuid
  action    BoardAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  profileId String      @db.Uuid
  profile   Profile     @relation(fields: [profileId], references: [id])
  role      BoardRole
  approve   Boolean
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@unique([actionId, profileId])
  @@map("board_approvals")
}

/**
 * Forum — contenedor de temas dentro de un grupo (comunidad).
 * Cada grupo tiene uno por defecto (isDefault), creado al vuelo.
 */
model Forum {
  id                 String   @id @default(uuid()) @db.Uuid
  groupId            String   @db.Uuid
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title              String   @db.VarChar(200)
  description        String?  @db.VarChar(1000)
  isDefault          Boolean  @default(false)
  createdByProfileId String?  @db.Uuid
  createdBy          Profile? @relation("ForumCreator", fields: [createdByProfileId], references: [id])
  createdAt          DateTime @default(now()) @db.Timestamptz

  proposals Proposal[]

  @@index([groupId])
  @@map("forums")
}

/**
 * ModerationAction — un ocultamiento con su motivo, apelación y resolución.
 */
model ModerationAction {
  id                   String           @id @default(uuid()) @db.Uuid
  target               ModerationTarget
  targetId             String           @db.Uuid
  reason               String           @db.VarChar(500)
  /// Null cuando la solicitud la abrió el asistente.
  moderatorProfileId   String?          @db.Uuid
  moderator            Profile?         @relation("Moderator", fields: [moderatorProfileId], references: [id])
  origen               Origen           @default(persona)
  status               ModerationStatus @default(oculto)
  appealText           String?          @db.VarChar(1000)
  appealedAt           DateTime?        @db.Timestamptz
  resolvedAt           DateTime?        @db.Timestamptz
  createdAt            DateTime         @default(now()) @db.Timestamptz
  /// Null en las moderaciones anteriores a las causas cerradas.
  causa                ModeracionCausa?
  /// Segunda persona de la mesa que confirmó o rechazó (columna simple, sin relación).
  confirmadorProfileId String?          @db.Uuid
  /// Plazo de una solicitud pendiente o provisional.
  venceAt              DateTime?        @db.Timestamptz
  /// Nació «provisional» (causa urgente). Si se rechaza o vence, una nueva solicitud urgente
  /// sobre el mismo contenido ya no lo oculta de inmediato: queda «pendiente».
  fueProvisional       Boolean          @default(false)

  // El índice único parcial `moderation_actions_abierta_key` (una sola solicitud pendiente o
  // provisional por contenido) vive solo en SQL: Prisma no modela índices parciales
  // (migración 20261106140100_una_solicitud_abierta_por_contenido).
  @@index([target, targetId])
  @@index([status])
  @@index([status, venceAt])
  @@map("moderation_actions")
}

/**
 * AuditEvent — log append-only de eventos críticos.
 * IMPORTANTE: Esta tabla nunca debe recibir UPDATE ni DELETE.
 * Un trigger de PostgreSQL lo enforza a nivel de base de datos.
 * Ver: prisma/sql/01_audit_append_only.sql
 * Los campos de PII (IP) se almacenan como hash, no en texto plano.
 */
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  // Actor del evento (null para eventos de sistema)
  actorId String? @db.Uuid
  actor   User?   @relation("AuditEventActor", fields: [actorId], references: [id])

  // Tipo de evento (ej: "user.invited", "user.login", "vote.cast")
  action String

  // Recurso afectado (ej: "user:uuid", "proposal:uuid")
  resource String?

  // Hash de la IP del cliente (SHA-256 + salt; no la IP directa)
  ipHash String?

  // Hash del payload completo para verificación de integridad
  payloadHash String?

  // Metadatos no sensibles del contexto
  metadata Json?

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_events")
}

/**
 * RuleValue — valor vigente de una regla votable. groupId nulo = valor de colmena.
 * La unicidad va en SQL con índices parciales (ver migración).
 */
model RuleValue {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @db.VarChar(80)
  groupId   String?  @db.Uuid
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  value     String   @db.VarChar(40)
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("rule_values")
}

/**
 * CambioRegla — propuesta de cambiar una regla votable (de colmena o de un grupo).
 * Índice único parcial hecho a mano en SQL (Prisma no lo conoce; no lo borre en migraciones futuras):
 *  - cambios_regla_abierto_key: UNIQUE ("key", "ambitoGroupId") WHERE "estado" IN ('en_votacion','pendiente_mesa')
 * autorProfileId es columna simple (sin relación).
 */
model CambioRegla {
  id             String            @id @default(uuid()) @db.Uuid
  key            String            @db.VarChar(80)
  nivel          String
  ambitoGroupId  String            @db.Uuid
  ambitoGroup    Group             @relation(fields: [ambitoGroupId], references: [id], onDelete: Cascade)
  valorAnterior  String            @db.VarChar(40)
  valorPropuesto String            @db.VarChar(40)
  proposalId     String            @unique @db.Uuid
  proposal       Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  autorProfileId String            @db.Uuid
  estado         CambioReglaEstado @default(en_votacion)
  boardActionId  String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz
  resueltoAt     DateTime?         @db.Timestamptz

  @@map("cambios_regla")
}

/**
 * Inquietud — preocupación planteada por un miembro; con apoyo suficiente
 * entra en plazo de respuesta. respondedByProfileId es columna simple (sin relación).
 */
model Inquietud {
  id                   String          @id @default(uuid()) @db.Uuid
  groupId              String          @db.Uuid
  group                Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorProfileId      String          @db.Uuid
  author               Profile         @relation(fields: [authorProfileId], references: [id])
  title                String          @db.VarChar(140)
  body                 String          @db.VarChar(2000)
  status               InquietudStatus @default(abierta)
  hidden               Boolean         @default(false)
  thresholdReachedAt   DateTime?       @db.Timestamptz
  deadlineAt           DateTime?       @db.Timestamptz
  response             String?         @db.VarChar(2000)
  respondedByProfileId String?         @db.Uuid
  respondedAt          DateTime?       @db.Timestamptz
  proposalId           String?         @db.Uuid
  proposal             Proposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  /// Solución de un subgrupo que originó esta inquietud ("llevar a la comunidad").
  origenSolucionId     String?         @unique @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  apoyos InquietudApoyo[]

  @@index([groupId, status])
  @@index([status, deadlineAt])
  @@map("inquietudes")
}

model InquietudApoyo {
  id          String    @id @default(uuid()) @db.Uuid
  inquietudId String    @db.Uuid
  inquietud   Inquietud @relation(fields: [inquietudId], references: [id], onDelete: Cascade)
  profileId   String    @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@unique([inquietudId, profileId])
  @@map("inquietud_apoyos")
}

/**
 * Frase — afirmación corta escrita por un miembro sobre una propuesta;
 * el grupo vota de acuerdo / en desacuerdo / paso.
 */
model Frase {
  id              String   @id @default(uuid()) @db.Uuid
  proposalId      String   @db.Uuid
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorProfileId String   @db.Uuid
  author          Profile  @relation(fields: [authorProfileId], references: [id])
  text            String   @db.VarChar(140)
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz

  votos FraseVoto[]

  @@index([proposalId])
  @@map("frases")
}

model FraseVoto {
  id        String         @id @default(uuid()) @db.Uuid
  fraseId   String         @db.Uuid
  frase     Frase          @relation(fields: [fraseId], references: [id], onDelete: Cascade)
  profileId String         @db.Uuid
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     FraseVotoValor
  createdAt DateTime       @default(now()) @db.Timestamptz
  updatedAt DateTime       @updatedAt @db.Timestamptz

  @@unique([fraseId, profileId])
  @@index([profileId])
  @@map("frase_votos")
}

/**
 * Solucion — alternativa de solución a una inquietud/tema, escrita por un miembro
 * o sugerida por el asistente. Puede fusionarse en otra (mergedIntoId).
 */
model Solucion {
  id              String   @id @default(uuid()) @db.Uuid
  proposalId      String   @db.Uuid
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorProfileId String   @db.Uuid
  author          Profile  @relation(fields: [authorProfileId], references: [id])
  title           String   @db.VarChar(140)
  description     String   @db.VarChar(2000)
  origen          Origen   @default(persona)
  hidden          Boolean  @default(false)
  mergedIntoId    String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@index([proposalId])
  @@map("soluciones")
}

/**
 * Decision — proceso de decisión de un tema: modo, objeción, votación por
 * papeleta ordenada y resultado (Schulze / aprobaciones).
 */
model Decision {
  id               String             @id @default(uuid()) @db.Uuid
  proposalId       String             @unique @db.Uuid
  proposal         Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fase             DecisionFase
  modo             DecisionModo?
  modoPropuesto    DecisionModo?
  objecionEndsAt   DateTime?          @db.Timestamptz
  votacionStartsAt DateTime?          @db.Timestamptz
  votacionEndsAt   DateTime?          @db.Timestamptz
  /// Orden congelado al abrir la votación.
  candidatas       String[]           @default([]) @db.Uuid
  resultado        DecisionResultado?
  ganadoras        String[]           @default([]) @db.Uuid
  /// Aprobaciones por índice de `candidatas`.
  aprobaciones     Int[]              @default([])
  pairwiseMatrix   Json?
  schulzeMatrix    Json?
  papeletasTotal   Int?
  abstenciones     Int?
  miembros         Int?
  contadaAt        DateTime?          @db.Timestamptz
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz

  papeletas  DecisionPapeleta[]
  objeciones ObjecionModo[]

  @@index([fase])
  @@map("decisiones")
}

model DecisionPapeleta {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  profileId  String   @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  abstencion Boolean
  orden      String[] @db.Uuid
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@unique([decisionId, profileId])
  @@map("decision_papeletas")
}

model ObjecionModo {
  id         String   @id @default(uuid()) @db.Uuid
  decisionId String   @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  profileId  String   @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@unique([decisionId, profileId])
  @@map("objeciones_modo")
}

/**
 * ComisionVoluntario — persona que se ofrece para una comisión, con su experiencia.
 */
model ComisionVoluntario {
  id          String   @id @default(uuid()) @db.Uuid
  grupoId     String   @db.Uuid
  grupo       Group    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  profileId   String   @db.Uuid
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experiencia String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@unique([grupoId, profileId])
  @@map("comision_voluntarios")
}

/**
 * ComisionInforme — informe periódico o final de una comisión. autorProfileId es columna simple.
 */
model ComisionInforme {
  id             String   @id @default(uuid()) @db.Uuid
  grupoId        String   @db.Uuid
  grupo          Group    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  autorProfileId String   @db.Uuid
  texto          String   @db.VarChar(5000)
  final          Boolean
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@index([grupoId, createdAt])
  @@map("comision_informes")
}

/**
 * ComisionRenovacionApoyo — apoyo de un miembro a renovar una comisión atrasada.
 */
model ComisionRenovacionApoyo {
  id        String   @id @default(uuid()) @db.Uuid
  grupoId   String   @db.Uuid
  grupo     Group    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([grupoId, profileId])
  @@map("comision_renovacion_apoyos")
}

/**
 * ComisionPapeleta — orden de preferencias (profileIds de voluntarios) de un votante.
 */
model ComisionPapeleta {
  id        String   @id @default(uuid()) @db.Uuid
  grupoId   String   @db.Uuid
  grupo     Group    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  orden     String[] @db.Uuid

  @@unique([grupoId, profileId])
  @@map("comision_papeletas")
}

/// Gasto del asistente por mes («AAAA-MM»), en millonésimas de dólar.
model UsoAsistente {
  mes               String    @id
  costoMicrodolares BigInt    @default(0)
  /// Cuándo se avisó que se alcanzó el tope (una sola vez al mes).
  avisoTopeAt       DateTime? @db.Timestamptz

  @@map("uso_asistente")
}

/// Texto que el asistente detectó como nivel 2 y espera la revisión de la mesa.
model TextoEnRevision {
  id            String         @id @default(uuid()) @db.Uuid
  autorProfileId String        @db.Uuid
  autor         Profile        @relation(fields: [autorProfileId], references: [id])
  tipo          String
  args          Json
  texto         String         @db.Text
  causa         ModeracionCausa
  estado        String         @default("pendiente")
  motivo        String?
  creadoAt      DateTime       @default(now()) @db.Timestamptz
  venceAt       DateTime       @db.Timestamptz
  resueltoAt    DateTime?      @db.Timestamptz

  firmas FirmaRevision[]

  @@index([estado, venceAt])
  @@map("textos_en_revision")
}

model FirmaRevision {
  revisionId String          @db.Uuid
  revision   TextoEnRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  profileId  String          @db.Uuid
  aprobar    Boolean
  createdAt  DateTime        @default(now()) @db.Timestamptz

  @@id([revisionId, profileId])
  @@map("firmas_revision")
}

/// Contenido publicado cuya revisión posterior (nivel 3) está pendiente.
model ColaRevisionPosterior {
  id       String            @id @default(uuid()) @db.Uuid
  target   ModerationTarget
  targetId String            @db.Uuid
  creadaAt DateTime          @default(now()) @db.Timestamptz
  intentos Int               @default(0)

  @@unique([target, targetId])
  @@map("cola_revision_posterior")
}
