# Base de datos propia del asistente (independiente de Decide Nicaragua)
DATABASE_URL=postgresql://asistente:asistente@localhost:5433/asistente

# API de Claude (visión + clasificación de intención)
ANTHROPIC_API_KEY=

# Secreto compartido con n8n: debe ir en el header x-webhook-secret
WEBHOOK_SECRET=

# Datos del negocio que van en el encabezado del invoice
BUSINESS_NAME=H&N Corintian Construction
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# Puerto del servicio (n8n lo llama en http://asistente:4100)
ASISTENTE_PORT=4100

# Binario de LibreOffice para exportar PDF (default: soffice en PATH)
# SOFFICE_BIN=/usr/bin/soffice
