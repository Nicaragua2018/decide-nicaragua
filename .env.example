# =============================================================
# Nicaragua Decide — Variables de entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# =============================================================

# --- Entorno ---
NODE_ENV=development
# Valores válidos: development | staging | production

# --- URLs (sin trailing slash) ---
# URL pública del frontend
APP_URL=http://localhost:3000
# URL pública del API (puede ser la misma con /api como prefijo en producción)
API_URL=http://localhost:4000

# --- Base de datos ---
DATABASE_URL=postgresql://decide:decide_dev_password@localhost:5432/decide_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Autenticación ---
# Mínimo 32 caracteres aleatorios. Generar con: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_string_minimum_32_required
# Duración del access token (formato ms/vercel/ms)
JWT_EXPIRY=15m
# Duración del refresh token
REFRESH_TOKEN_EXPIRY=30d
# Dominio para las cookies de sesión
# En desarrollo: localhost
# En producción: .tudominio.com (con punto inicial para subdominios)
COOKIE_DOMAIN=localhost

# --- Email (Resend) ---
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Dirección "From" para emails transaccionales
EMAIL_FROM=noreply@tudominio.com
EMAIL_FROM_NAME=Nicaragua Decide

# --- Asistente de IA (Claude) ---
# Interruptor: el asistente solo funciona si vale exactamente "true". Apagado por defecto.
# Se deja en false hasta aprobar el examen completo (ADR-025):
#   ASISTENTE_ACTIVO=true pnpm --filter @decide/api asistente:examen
# Repetir el examen antes de cada cambio de instrucciones o de modelo.
ASISTENTE_ACTIVO=false
# Clave de la API de Anthropic. NUNCA en el repositorio ni en los registros.
# Si falta, el asistente queda apagado aunque ASISTENTE_ACTIVO sea "true".
ANTHROPIC_API_KEY=
# Tope de gasto mensual en dólares (por defecto 20). Las tareas nocturnas paran al 80 %
# y las interactivas al 100 %.
ASISTENTE_TOPE_MENSUAL_USD=20
# Modelos: rápido (moderación) y capaz (tareas largas)
ASISTENTE_MODELO_RAPIDO=claude-haiku-5-5
ASISTENTE_MODELO_CAPAZ=claude-sonnet-5-5
# Correo del administrador que recibe el aviso de tope alcanzado (si está vacío, no se envía)
ASISTENTE_AVISO_EMAIL=

# --- Puerto del API ---
API_PORT=4000

# --- Seguridad — Hashing de IPs ---
# Salt para el hash de IPs en el audit log. Generar con: openssl rand -hex 32
# Rotar periódicamente limita la correlación de IPs a largo plazo.
IP_HASH_SALT=change_me_to_a_random_salt_for_ip_hashing

# --- Seed del admin inicial ---
# Solo necesario para ejecutar: pnpm db:seed
# No es necesario en producción después del primer seed.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_me_minimum_12_chars

# --- Seguridad interna ---
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_random_secret

# --- PostgreSQL (solo producción con docker-compose.yml) ---
# Usuario y nombre de la base de datos (creados al iniciar el contenedor)
POSTGRES_USER=decide
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=decide

# --- Dominio de producción (sin https://) ---
# Ejemplo: decide.tudominio.com
# Genera: https://decide.tudominio.com (web) y https://api.decide.tudominio.com (api)
APP_DOMAIN=decide.tudominio.com

# --- Traefik (solo producción) ---
# Email para certificados Let's Encrypt
TRAEFIK_ACME_EMAIL=admin@tudominio.com
# Contraseña para el dashboard de Traefik (hash htpasswd)
# Generar con: htpasswd -nb admin tu_password
# Escapar $ con $$ en docker-compose labels
TRAEFIK_DASHBOARD_PASSWORD=admin:$$apr1$$xxxx
